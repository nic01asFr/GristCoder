# ── GristCoderMCP · .env ───────────────────────────────────────────────────
#
# Two auth paths, same identity: uid:{user_id}
#
#   Grist widget:
#     Auto-connects via grist.docApi.getAccessToken()
#     No manual key needed
#
#   Claude Desktop / Claude Code:
#     Authorization: Bearer <grist_api_key>
#     Get your key from: Grist → Profile → API → Create a key

# Public URL of this service (ngrok, fixed domain, or localhost)
HOST_URL=http://localhost:8742

# Shared secret for /webhook-receive (optional, recommended in production)
# Configure the same secret in Grist → Webhook → Header: X-Webhook-Secret
# WEBHOOK_SECRET=change-me

# Hotes autorises pour /llm-proxy (CSV). Vide = endpoint desactive (anti-SSRF).
# Ex pour le harness agent embarque : llm.lab.sspcloud.fr,albert.api.etalab.gouv.fr
LLM_PROXY_ALLOWED_HOSTS=
