# ── grist-coder-mcp · .env ─────────────────────────────────────────────────
#
# AUTH v4.3 : Deux chemins d authentification, meme identite uid:{user_id}
#
#   Widget Grist :
#     Connexion automatique via grist.docApi.getAccessToken()
#     Aucune saisie manuelle de cle requise
#
#   Claude Desktop :
#     Authorization: Bearer <cle_grist>
#     Cle Grist disponible dans : Grist -> Profile -> API -> Creer une cle

# URL publique du service (ngrok, domaine fixe, ou localhost)
# Utilisee dans les ressources MCP grist-coder://ui/{token}
HOST_URL=http://localhost:8742
