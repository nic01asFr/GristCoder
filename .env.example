# ── GristCoderMCP · .env ───────────────────────────────────────────────────
#
# Two auth paths, same identity: uid:{user_id}
#
#   Grist widget:
#     Auto-connects via grist.docApi.getAccessToken()
#     No manual key needed
#
#   Claude Desktop / Claude Code:
#     Authorization: Bearer <grist_api_key>
#     Get your key from: Grist → Profile → API → Create a key

# Public URL of this service (ngrok, fixed domain, or localhost)
HOST_URL=http://localhost:8742

# Shared secret for /webhook-receive (optional, recommended in production)
# Configure the same secret in Grist → Webhook → Header: X-Webhook-Secret
# WEBHOOK_SECRET=change-me

# Hotes autorises pour /llm-proxy (CSV). Vide = endpoint desactive (anti-SSRF).
# Ex pour le harness agent embarque : llm.lab.sspcloud.fr,albert.api.etalab.gouv.fr
LLM_PROXY_ALLOWED_HOSTS=

# ── Provisioning (grist_doc_create) ──────────────────────────────────────────
# Permet a l'outil grist_doc_create de creer un NOUVEAU document vierge pour le
# user, le nommer, y ajouter le widget Coder et renvoyer le lien cliquable.
# GRIST_PROVISION_KEY      : cle API Grist owner du workspace cible (Profile -> API)
# GRIST_PROVISION_WORKSPACE_ID : id numerique du workspace ou creer les docs
# GRIST_PROVISION_ORG      : org Grist (defaut 'docs' pour grist.numerique.gouv.fr)
# GRIST_CODER_WIDGET_URL   : URL publique de CE serveur (defaut HOST_URL/localhost)
# GRIST_SITE_URL           : base du site Grist si aucune session widget active
# GRIST_PROVISION_KEY=
# GRIST_PROVISION_WORKSPACE_ID=
# GRIST_PROVISION_ORG=docs
# GRIST_CODER_WIDGET_URL=http://localhost:8742
# GRIST_SITE_URL=https://grist.numerique.gouv.fr

# Taille max de lignes par lot pour les gros BulkAddRecord (imports massifs).
# Au-dela, grist_apply decoupe en lots sequentiels pour passer sous le WAF. Defaut 200.
# GRIST_BULK_MAX_ROWS=200
